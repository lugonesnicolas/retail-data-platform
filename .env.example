# -----------------------------------------------------------------------------
# Retail Data Platform - environment configuration
#
#   cp .env.example .env        (or: make setup - also generates random secrets)
#
# Values marked CHANGE_ME must be replaced. `make setup` replaces every
# CHANGE_ME with a random hex secret and generates the Airflow Fernet key.
# Use URL-safe passwords (hex/alphanumeric): some are embedded in connection URLs.
# Never commit .env.
# -----------------------------------------------------------------------------

# --- PostgreSQL superuser (only used by the postgres container itself) -------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
# Host port for local access (bound to 127.0.0.1 only)
POSTGRES_PORT=5432

# --- Warehouse database (raw / staging / intermediate / mart / ops) ----------
WAREHOUSE_DB_NAME=retail
WAREHOUSE_DB_USER=retail
WAREHOUSE_DB_PASSWORD=CHANGE_ME

# --- Read-only role used by the dashboard and Grafana (SELECT on mart only) --
DASHBOARD_DB_USER=retail_reader
DASHBOARD_DB_PASSWORD=CHANGE_ME

# --- Airflow ----------------------------------------------------------------
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
# Fernet key: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=CHANGE_ME_FERNET
AIRFLOW_JWT_SECRET=CHANGE_ME
AIRFLOW_SECRET_KEY=CHANGE_ME
AIRFLOW_PORT=8080

# --- Pipeline behaviour -------------------------------------------------------
# live   = call dummyjson.com and books.toscrape.com
# replay = serve committed fixtures through the same code path (offline/CI demos)
RDP_SOURCE_MODE=live
RDP_ENABLED_SOURCES=api,web,dataset
# Cron expression or preset (@daily, @hourly); "none" = manual triggers only
RDP_PIPELINE_SCHEDULE=@daily
# Share of records violating the contract above which a source batch is rejected
RDP_MAX_REJECT_RATIO=0.2
RDP_WEB_CATEGORIES=Travel,Mystery,Poetry,Science,Business
RDP_LOG_LEVEL=INFO
RDP_DBT_TARGET=dev

# --- Dashboard ----------------------------------------------------------------
DASHBOARD_PORT=8501
RDP_DASHBOARD_CACHE_TTL=300

# --- Optional Grafana (docker compose --profile observability) ---------------
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_PORT=3000

# --- Production only (deploy/docker-compose.prod.yml) --------------------------
# Public DNS name pointing at the VM; Caddy obtains TLS certificates for
# DOMAIN and airflow.DOMAIN automatically.
DOMAIN=example.com
ACME_EMAIL=admin@example.com
