# Copy to terraform.tfvars (git-ignored) and fill in.
# WARNING: `terraform apply` creates billable Azure resources (VM, disk, public IP).
#          Run `terraform destroy` when you no longer need them.

subscription_id   = "00000000-0000-0000-0000-000000000000"
location          = "westeurope"
project           = "retail-data-platform"
vm_size           = "Standard_B2ms"
admin_username    = "deploy"
ssh_public_key    = "ssh-ed25519 AAAA... you@example.com"
ssh_allowed_cidrs = ["203.0.113.10/32"]
dns_label         = "" # e.g. "my-retail-demo" -> my-retail-demo.westeurope.cloudapp.azure.com
